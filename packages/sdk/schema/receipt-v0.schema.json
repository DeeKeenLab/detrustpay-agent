{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detrustpay.dev/schemas/receipt-v0.json",
  "title": "DeTrustPay Delivery Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "taskId", "order", "provider", "submittedAt", "artifact"],
  "properties": {
    "schema": { "const": "detrustpay.receipt.v0" },
    "taskId": { "type": "string", "format": "uuid" },
    "order": { "$ref": "#/$defs/solanaAddress" },
    "provider": { "$ref": "#/$defs/solanaAddress" },
    "submittedAt": { "type": "string", "format": "date-time" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "mediaType", "bytes"],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^(ipfs://|ar://).+",
          "maxLength": 120
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 127 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "notes": { "type": "string", "maxLength": 2048 }
  },
  "$defs": {
    "solanaAddress": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    }
  }
}
