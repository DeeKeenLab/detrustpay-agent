{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detrustpay.dev/schemas/task-v0.json",
  "title": "DeTrustPay Agent Task v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "taskId",
    "requester",
    "provider",
    "title",
    "description",
    "acceptanceCriteria",
    "artifact",
    "settlement",
    "timing"
  ],
  "properties": {
    "schema": { "const": "detrustpay.task.v0" },
    "taskId": { "type": "string", "format": "uuid" },
    "requester": { "$ref": "#/$defs/solanaAddress" },
    "provider": {
      "oneOf": [
        { "$ref": "#/$defs/solanaAddress" },
        { "type": "null" }
      ],
      "description": "A restricted provider address, or null for an open task."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaTypes", "maximumBytes"],
      "properties": {
        "mediaTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 127 }
        },
        "maximumBytes": { "type": "integer", "minimum": 1 },
        "instructions": { "type": "string", "maxLength": 2048 }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster",
        "programId",
        "mint",
        "paymentBaseUnits",
        "mutualDepositBaseUnits",
        "adjustable"
      ],
      "properties": {
        "cluster": { "const": "devnet" },
        "programId": { "const": "3S3kY64L8a3torKLpqEzkQeqDX82wjKRFXDMvxq2KcnL" },
        "mint": { "const": "4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU" },
        "paymentBaseUnits": { "$ref": "#/$defs/baseUnits" },
        "mutualDepositBaseUnits": {
          "$ref": "#/$defs/baseUnits",
          "description": "The equal deposit applied to both payer and payee. V0 policy requires 25% to 400% of payment."
        },
        "adjustable": { "type": "boolean" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptBy", "deliverBy"],
      "properties": {
        "acceptBy": {
          "type": "integer",
          "minimum": 1,
          "description": "Unix timestamp enforced by the listing expiration."
        },
        "deliverBy": {
          "type": "string",
          "format": "date-time",
          "description": "Off-chain acceptance policy; the current program does not automatically enforce this deadline."
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    }
  },
  "$defs": {
    "solanaAddress": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "baseUnits": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "An unsigned integer encoded as a decimal string to avoid JavaScript precision loss."
    }
  }
}
